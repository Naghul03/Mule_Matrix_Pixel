# Mule Matrix Environment Configuration
PROJECT_NAME="Mule Matrix"
ENV="development"
DEBUG=true

# Database: SQLite by default for zero-friction local run; switch to PostgreSQL as needed
DATABASE_URL="sqlite:///./mule_matrix.db"
# PostgreSQL Alternative:
# DATABASE_URL="postgresql+psycopg2://mule_user:mule_pass@localhost:5432/mule_matrix"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Detection & Lineage Defaults
DEFAULT_LOOKBACK_HOURS=72
DEFAULT_LOOKAHEAD_HOURS=72
DEFAULT_MAX_HOPS=12
DEFAULT_MAX_NODES=150
DEFAULT_MAX_EDGES=300
DEFAULT_PASS_THROUGH_RATIO_THRESHOLD=0.85
DEFAULT_VELOCITY_BURST_THRESHOLD=5
DEFAULT_RETENTION_MIN=0.01
DEFAULT_RETENTION_MAX=0.15
